{
  "enabledPlugins": {
    "caveman@caveman": false
  },
  "sandbox": {
    "filesystem": { "allowWrite": ["~/.local/state/orch"] },
    "excludedCommands": [
      "claude:*",
      "orchctl:*"
    ]
  },
  "permissions": {
    "allow": [
      "Bash(orchctl:*)",
      "Read(~/.local/state/orch/**)"
    ]
  }
}
